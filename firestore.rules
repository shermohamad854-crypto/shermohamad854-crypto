rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: employees
    // Fields: name, email, role, department, joinDate, salary, status, photoURL
    //
    // Collection: attendance
    // Fields: employeeId, date, checkIn, checkOut, status
    //
    // Collection: payroll
    // Fields: employeeId, month, year, baseSalary, bonus, deductions, netSalary, status
    //
    // Collection: vehicles
    // Fields: vehicleNumber, vehicleName, nocUrl, driverName, driverContact, assignmentDate, approvedBy, handoverDate, status
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isDefaultAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == "shermohamad854@gmail.com" && 
             request.auth.token.email_verified == true;
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'employee';
    }

    function isAdmin() {
      return isAuthenticated() && (
        isDefaultAdmin() || 
        getUserRole() == 'admin'
      );
    }

    function isHR() {
      return isAuthenticated() && (
        isDefaultAdmin() || 
        getUserRole() in ['hr', 'admin']
      );
    }

    function isManager() {
      return isAuthenticated() && (
        isDefaultAdmin() || 
        getUserRole() in ['manager', 'hr', 'admin']
      );
    }

    // Users: Admins can manage all. Users can read/create their own.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        request.resource.data.role == 'employee' || 
        (request.resource.data.role == 'admin' && isDefaultAdmin())
      );
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // Employees: Authenticated read. HR and Admins can write.
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow write: if isHR();
    }

    // Attendance: Authenticated read. HR and Admins can write. Users can write their own.
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isHR() || (isAuthenticated() && request.resource.data.employeeId == request.auth.uid);
    }

    // Payroll: HR and Admins can read/write. Users can read their own. (Keep sensitive)
    match /payroll/{payrollId} {
      allow read: if isHR() || (isAuthenticated() && resource.data.employeeId == request.auth.uid);
      allow write: if isHR();
    }

    // Tasks: Authenticated read. Admins/Managers can write.
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isManager() || (isAuthenticated() && (resource.data.assignedTo == request.auth.uid || request.resource.data.assignedTo == request.auth.uid));
    }

    // Inventory: Authenticated read. Admins can write.
    match /inventory/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Vehicles: Authenticated read. Admins/Managers can write.
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Settings: Authenticated read. Admins can write.
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
