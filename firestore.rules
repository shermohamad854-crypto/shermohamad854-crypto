rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: employees
    // Fields: name, email, role, department, joinDate, salary, status, photoURL
    //
    // Collection: attendance
    // Fields: employeeId, date, checkIn, checkOut, status
    //
    // Collection: payroll
    // Fields: employeeId, month, year, baseSalary, bonus, deductions, netSalary, status
    //
    // Collection: vehicles
    // Fields: vehicleNumber, vehicleName, nocUrl, driverName, driverContact, assignmentDate, approvedBy, handoverDate, status
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) 
        ? get(/databases/$(database)/documents/users/$(uid)).data 
        : null;
    }

    function isDefaultAdmin() {
      return request.auth.token.email == "shermohamad854@gmail.com" && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isAuthenticated() && (
        isDefaultAdmin() || 
        (getUserData(request.auth.uid) != null && getUserData(request.auth.uid).role == 'admin')
      );
    }

    function isHR() {
      return isAuthenticated() && (
        isDefaultAdmin() || 
        (getUserData(request.auth.uid) != null && (getUserData(request.auth.uid).role == 'hr' || getUserData(request.auth.uid).role == 'admin'))
      );
    }

    function isManager() {
      return isAuthenticated() && (
        isDefaultAdmin() || 
        (getUserData(request.auth.uid) != null && (getUserData(request.auth.uid).role == 'manager' || getUserData(request.auth.uid).role == 'hr' || getUserData(request.auth.uid).role == 'admin'))
      );
    }

    // Users: Admins can manage all. Users can read/create their own.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        request.resource.data.role == 'employee' || 
        (request.resource.data.role == 'admin' && isDefaultAdmin())
      );
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // Employees: HR and Admins can read/write. Managers can read.
    match /employees/{employeeId} {
      allow read: if isManager() || (isAuthenticated() && request.auth.token.email == resource.data.email);
      allow write: if isHR();
    }

    // Attendance: HR and Admins can read/write. Managers can read. Users can read/write their own.
    match /attendance/{attendanceId} {
      allow read: if isManager() || (isAuthenticated() && (resource.data.employeeId == request.auth.uid || request.resource.data.employeeId == request.auth.uid));
      allow write: if isHR() || (isAuthenticated() && request.resource.data.employeeId == request.auth.uid);
    }

    // Payroll: HR and Admins can read/write. Users can read their own.
    match /payroll/{payrollId} {
      allow read: if isHR() || (isAuthenticated() && resource.data.employeeId == request.auth.uid);
      allow write: if isHR();
    }

    // Tasks: Admins/Managers can read/write. Users can read/write tasks assigned to them.
    match /tasks/{taskId} {
      allow read, write: if isManager() || (isAuthenticated() && (resource.data.assignedTo == request.auth.uid || request.resource.data.assignedTo == request.auth.uid));
    }

    // Inventory: Admins can read/write all. Authenticated users can read.
    match /inventory/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Vehicles: Admins/Managers can read/write.
    match /vehicles/{vehicleId} {
      allow read, write: if isManager();
    }

    // Settings: Admins can read/write. Authenticated users can read. general is public for branding.
    match /settings/{settingId} {
      allow read: if isAuthenticated() || settingId == 'general';
      allow write: if isAdmin();
    }
  }
}
